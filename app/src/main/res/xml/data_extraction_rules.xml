<?xml version="1.0" encoding="utf-8"?>
<!-- Used on Android 12 and higher, same rule as backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
