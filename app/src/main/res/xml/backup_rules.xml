<?xml version="1.0" encoding="utf-8"?>
<!-- Used on Android 11 and lower. The encrypted session is left out of backups because the
     Keystore key does not travel with the backup, so a restored copy could never be decrypted. -->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_session.xml" />
</full-backup-content>
